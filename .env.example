# ══════════════════════════════════════
# Database Configuration
# ══════════════════════════════════════
POSTGRES_USER=anook_user
POSTGRES_PASSWORD=anook_password
POSTGRES_DB=anook_db
DB_PORT=5412

# ══════════════════════════════════════
# Security Configuration
# ══════════════════════════════════════
JWT_SECRET=your_jwt_secret_key_here

# ══════════════════════════════════════
# Demo Login (포트폴리오 데모 팝업)
# ══════════════════════════════════════
# 로그인 화면의 데모 팝업이 사용하는 계정.
# 아래 값은 docker-compose.yml에 기본값이 있어서 .env 없이도 동작한다.
#
# DEMO_ADMIN_PIN   : '관리자로 체험' 버튼이 사용할 직원 PIN (data.sql의 '데모관리자')
# DEMO_GUEST_CODE  : '투숙객으로 체험' 버튼이 사용할 접속 코드 (data.sql의 707호 김철수)
# DEMO_STAFF_PINS  : 중복 로그인(JTI) 검사를 면제할 PIN 목록. 쉼표로 구분.
#                    여러 방문자가 동시에 데모를 봐야 하므로 필요하다.
#                    운영 전환 시 빈 값으로 두면 기능이 완전히 비활성화된다.
DEMO_ADMIN_PIN=999999
DEMO_GUEST_CODE=test-guest-code-1234
DEMO_STAFF_PINS=999999

# ══════════════════════════════════════
# AI Configuration (Gemini)
# ══════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key_here

# ══════════════════════════════════════
# Spring Boot
# ══════════════════════════════════════
SPRING_PROFILE=prod

# ══════════════════════════════════════
# Port Configuration
# ══════════════════════════════════════
FRONTEND_PORT=

# ══════════════════════════════════════
# Neo4j (Graph RAG) Configuration
# ══════════════════════════════════════
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=

# ══════════════════════════════════════
# Exchange Rate API (한국수출입은행)
# https://www.koreaexim.go.kr/ir/HPHKIR020M01
# ══════════════════════════════════════
KOREAEXIM_AUTH_KEY=your_koreaexim_authkey_here
